{
  "version": "2.8",
  "children": [
    {
      "type": "frame",
      "id": "auth-canvas",
      "name": "Enterprise Dark / Deep Slate - Auth & Management Hub",
      "x": 0,
      "y": 0,
      "width": 2600,
      "height": 920,
      "fill": "#090D16",
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "screen-register",
          "name": "Screen 1: Register Page (/register)",
          "x": 60,
          "y": 60,
          "width": 480,
          "height": 780,
          "fill": "#0F172A",
          "cornerRadius": 20,
          "stroke": { "fill": "#1E293B", "thickness": 1 },
          "layout": "vertical",
          "padding": 36,
          "gap": 22,
          "children": [
            {
              "type": "frame",
              "id": "reg-pill",
              "height": 28,
              "cornerRadius": 14,
              "fill": "#064E3B",
              "padding": 10,
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "reg-pill-text", "content": "● SECURE PROVISIONING", "fontSize": 11, "fontWeight": 700, "fill": "#34D399" }
              ]
            },
            {
              "type": "text",
              "id": "reg-title",
              "name": "Title",
              "content": "Create Account",
              "fontSize": 24,
              "fontWeight": 700,
              "fill": "#F8FAFC"
            },
            {
              "type": "text",
              "id": "reg-sub",
              "name": "Subtitle",
              "content": "Set up your credentials for the Management Hub.",
              "fontSize": 13,
              "fill": "#94A3B8"
            },
            {
              "type": "frame",
              "id": "reg-name-group",
              "name": "Name Input Group",
              "width": "fill",
              "layout": "vertical",
              "gap": 8,
              "children": [
                { "type": "text", "id": "reg-name-label", "content": "Full Name", "fontSize": 13, "fontWeight": 500, "fill": "#E2E8F0" },
                {
                  "type": "frame",
                  "id": "reg-name-input",
                  "width": "fill",
                  "height": 44,
                  "cornerRadius": 10,
                  "fill": "#0B0F19",
                  "stroke": { "fill": "#1E293B", "thickness": 1 },
                  "padding": 12,
                  "children": [{ "type": "text", "id": "reg-name-placeholder", "content": "Alex Johnson", "fontSize": 14, "fill": "#64748B" }]
                }
              ]
            },
            {
              "type": "frame",
              "id": "reg-email-group",
              "name": "Email Input Group",
              "width": "fill",
              "layout": "vertical",
              "gap": 8,
              "children": [
                { "type": "text", "id": "reg-email-label", "content": "Work Email", "fontSize": 13, "fontWeight": 500, "fill": "#E2E8F0" },
                {
                  "type": "frame",
                  "id": "reg-email-input",
                  "width": "fill",
                  "height": 44,
                  "cornerRadius": 10,
                  "fill": "#0B0F19",
                  "stroke": { "fill": "#1E293B", "thickness": 1 },
