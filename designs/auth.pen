                  "children": [{ "type": "text", "id": "reg-email-placeholder", "content": "alex@enterprise.io", "fontSize": 14, "fill": "#64748B" }]
                }
              ]
            },
            {
              "type": "frame",
              "id": "reg-pass-group",
              "name": "Password Input Group",
              "width": "fill",
              "layout": "vertical",
              "gap": 8,
              "children": [
                { "type": "text", "id": "reg-pass-label", "content": "Master Password", "fontSize": 13, "fontWeight": 500, "fill": "#E2E8F0" },
                {
                  "type": "frame",
                  "id": "reg-pass-input",
                  "width": "fill",
                  "height": 44,
                  "cornerRadius": 10,
                  "fill": "#0B0F19",
                  "stroke": { "fill": "#1E293B", "thickness": 1 },
                  "padding": 12,
                  "children": [{ "type": "text", "id": "reg-pass-placeholder", "content": "••••••••••••••••", "fontSize": 14, "fill": "#64748B" }]
                },
                {
                  "type": "frame",
                  "id": "reg-meter",
                  "width": "fill",
                  "layout": "horizontal",
                  "gap": 6,
                  "children": [
                    { "type": "frame", "id": "m1", "width": 95, "height": 4, "cornerRadius": 2, "fill": "#10B981" },
                    { "type": "frame", "id": "m2", "width": 95, "height": 4, "cornerRadius": 2, "fill": "#10B981" },
                    { "type": "frame", "id": "m3", "width": 95, "height": 4, "cornerRadius": 2, "fill": "#10B981" },
                    { "type": "frame", "id": "m4", "width": 95, "height": 4, "cornerRadius": 2, "fill": "#334155" }
                  ]
                },
                { "type": "text", "id": "reg-pass-hint", "content": "Entropy: High (Minimum 8 chars + special symbol)", "fontSize": 11, "fill": "#94A3B8" }
